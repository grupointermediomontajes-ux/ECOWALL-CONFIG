{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ECOWALL Configurador",
  "version": "0.1.16",
  "identifier": "com.ecowall.configurador",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run css",
    "beforeBuildCommand": "npm run css"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CONFIGURADOR ECOWALL",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}